<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / default network policy: HTTPS only. Cleartext HTTP is refused for every host.
  Debug builds replace this file (app/src/debug/res/xml/network_security_config.xml) with a version that additionally
  allows cleartext to the emulator-host/localhost addresses ONLY, so a local Express backend can be used in development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
