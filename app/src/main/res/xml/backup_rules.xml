<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (API < 31): nothing is backed up. This app keeps no data worth restoring, and session state, any
  account identifiers and wellbeing data must never leave the device through a cloud backup.
  (The manifest also sets android:allowBackup="false"; these rules are defence in depth.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
